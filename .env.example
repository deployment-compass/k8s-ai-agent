# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# LLM configuration
# Provider: mock | openrouter | groq | gemini | ollama | openai
LLM_PROVIDER=openrouter
# Get a free key at https://openrouter.ai/ (account settings -> keys)
LLM_API_KEY=
# Free model IDs rotate; check https://openrouter.ai/models with the ":free" filter
# llama-3.3-70b-instruct supports native tool calling (recommended for Phase 5+)
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Tool calling: auto (native, falls back to prompted) | native | prompted
# LLM_TOOL_MODE=auto
# Optional overrides (derived from provider when empty)
# LLM_BASE_URL=
# LLM_TIMEOUT_SECONDS=30
# LLM_TEMPERATURE=0.2
# LLM_MAX_RETRIES=2

# Agent behavior
# Namespace used when the model omits it in tool calls
# DEFAULT_NAMESPACE=default
# Max tool-execution rounds per chat request
# AGENT_MAX_TOOL_ITERATIONS=8

# Agent activity logging (console)
# AGENT_LOG_ENABLED=true
# AGENT_LOG_LEVEL=INFO

# Kubernetes config will go here
# KUBECONFIG=
